# Copy to build.env in the project root (never commit it) and fill in.
# The API ID of the app for friends: create it at https://my.telegram.org with
# a separate phone number, so that a ban of this ID never touches your own.
TELEGRAM_BUILD_API_ID=
TELEGRAM_BUILD_API_HASH=
# Friends' copies start in "read only" mode; they can switch it on the settings page.
TELEGRAM_BUILD_READ_ONLY_DEFAULT=true
