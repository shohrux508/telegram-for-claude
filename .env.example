# Get both values at https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional settings (defaults shown)
# TELEGRAM_MCP_DATA_DIR=~/.telegram-mcp
# TELEGRAM_MCP_DEFAULT_ACCOUNT=main
# TELEGRAM_MCP_READ_ONLY=false
# TELEGRAM_MCP_LOG_LEVEL=INFO

# Chats Claude must never see and that are never archived: ids as printed by
# list_chats, comma-separated. Telegram's login-code chats are hidden regardless.
# TELEGRAM_MCP_HIDDEN_CHATS=-1001234567890,987654321

# History archive: local (a file on this computer, default), core (your server) or off.
# TELEGRAM_MCP_ARCHIVE_MODE=local
# TELEGRAM_MCP_AUTO_SYNC=true
# TELEGRAM_MCP_SYNC_INTERVAL_MINUTES=10

# Archive on the core server: setting both switches the archive to core.
# URL is the root of core's domain; the token is core's MCP_TOKEN.
TELEGRAM_MCP_CORE_URL=
TELEGRAM_MCP_CORE_TOKEN=
# Messages taken per chat the first time it is archived
# TELEGRAM_MCP_SYNC_INITIAL_LIMIT=300
